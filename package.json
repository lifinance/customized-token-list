  "packageManager": "pnpm@10.14.0",
  "devDependencies": {
    "@lifi/types": "^18.15.0",
    "@types/lodash": "^4.17.20",
    "@types/node": "^26.6.6",
    "ajv": "^8.12.0",
    "husky": "^9.1.7",
    "lodash": "^4.17.21",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
